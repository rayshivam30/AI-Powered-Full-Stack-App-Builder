# ==========================================
# Lovable AI Monorepo Environment Variables
# ==========================================

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL / Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lovable_db
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# Security Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters

# Stripe Payment Gateway
STRIPE_API_SECRET=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Client Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MinIO / Cloudflare R2 Object Storage
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
